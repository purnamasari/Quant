# Copy this file to .env and fill in your own values. .env is gitignored.

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Comma-separated list of stock/ETF symbols to scan. Leave empty to scan
# the full bundled directory (data/symbol-directory.json, ~90 large-cap
# US stocks/ETFs).
STOCK_WATCHLIST=

# Comma-separated list of crypto pairs (OKX instrument IDs) to scan.
CRYPTO_WATCHLIST=BTC-USDT,ETH-USDT,SOL-USDT,BNB-USDT,XRP-USDT,ZEC-USDT,HYPE-USDT

# Max hold horizon in trading days used by the backtest + alert filter.
HOLD_DAYS=2

# --- Leveraged position sizing (see data/risk-management-plan.md) ---
# Account equity used to turn each alert into a concrete position size.
# Leave at 0 to keep alerts generic (they still show max safe leverage and
# the notional-per-unit-of-risk ratio, just no dollar amounts).
ACCOUNT_SIZE=0

# Percent of the account lost if the stop is hit. 1% is the conventional
# ceiling and is already aggressive once several correlated crypto longs can
# be open simultaneously.
RISK_PERCENT=1

# Crypto longs are largely the same bet on BTC (correlation 0.7-0.9), so N
# open positions is close to N x risk. 3 positions = 3% total account heat.
MAX_CONCURRENT_POSITIONS=3
