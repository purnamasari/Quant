{
  "name": "quant-signal-bot",
  "version": "0.1.0",
  "private": true,
  "description": "Telegram alert bot for short-swing (1-2 day hold) stock and crypto signals, built on Quant's signal detection logic.",
  "type": "commonjs",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "job": "node src/job.js",
    "crypto-job": "node src/cryptoJob.js",
    "macro-ping": "node src/macroPing.js",
    "backtest:stock": "node src/stock/backtest.js",
    "backtest:crypto": "node src/crypto/backtest.js",
    "correlate": "node src/analysis/correlateSignals.js",
    "risk:leverage": "node src/analysis/leverageRisk.js",
    "risk:funding": "node src/analysis/fundingCost.js",
    "news:harvest": "node src/analysis/newsBacktest.js harvest",
    "news:analyze": "node src/analysis/newsBacktest.js analyze",
    "events:harvest": "node src/analysis/eventStudy.js harvest",
    "events:csv": "node src/analysis/eventStudy.js csv",
    "events:show": "node src/analysis/eventStudy.js show",
    "events:scalp": "node src/analysis/newsScalpBacktest.js",
    "experiment:pairs": "node src/analysis/pairsTrading.js",
    "experiment:swing-stop": "node src/analysis/swingStopTest.js",
    "experiment:rmultiple": "node src/analysis/rMultipleBacktest.js",
    "news:hypotheses": "node src/analysis/newsHypothesesRun.js",
    "control:stock": "node src/analysis/stockConfluenceTest.js",
    "scoreboard": "node src/analysis/strategyScoreboard.js",
    "scoreboard:regime": "node src/analysis/regimeScoreboard.js",
    "dashboard": "node src/dashboard/server.js",
    "structure:freq": "node src/analysis/structureFrequency.js"
  },
  "dependencies": {
    "playwright": "^1.62.0"
  }
}
